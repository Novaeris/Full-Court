# Copy to supabase/.env (git-ignored). The Supabase CLI reads it for the
# env(...) values in config.toml when running `supabase config push`.

# Resend API key with "Sending access" restricted to the Full Court domain.
RESEND_API_KEY=re_replace_me

# Sender address on the verified Resend domain, e.g. noreply@mail.example.com
STAGING_EMAIL_FROM=noreply@mail.example.com
