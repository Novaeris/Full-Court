{
  "name": "full-court",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "turbo run dev --filter=@fullcourt/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "node scripts/check-boundaries.mjs",
    "secrets": "node scripts/scan-secrets.mjs",
    "verify": "node scripts/verify.mjs",
    "test:e2e:update": "playwright test --update-snapshots",
    "db:types": "supabase gen types typescript --local --schema public > packages/api-client/src/database.types.ts",
    "scan:bundle": "node scripts/scan-bundle.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fullcourt/api-client": "workspace:*",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.0",
    "@supabase/supabase-js": "2.119.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
