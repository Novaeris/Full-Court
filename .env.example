# Copy to apps/web/.env.local and fill in. Never commit real values: this repo is public.

# Supabase project URL and publishable (anon) key. Safe for browsers; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me

# Server-only secrets are added in later phases, never with a NEXT_PUBLIC_ prefix.
# SUPABASE_SECRET_KEY lives only in Render (worker + audited admin modules).
