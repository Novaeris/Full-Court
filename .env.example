# Copy to apps/web/.env.local and fill in. Never commit real values: this repo is public.
# For local development, `supabase status -o env` prints the URL and publishable key.

# Supabase project URL and publishable key. Safe for browsers; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me

# Origin used in auth email links. Must be on the Supabase redirect allowlist.
# On Render it defaults to RENDER_EXTERNAL_URL, so it can be left unset there.
SITE_URL=http://localhost:3000

# Server-only secrets are never given a NEXT_PUBLIC_ prefix.
# SUPABASE_SECRET_KEY lives only in Render (worker + audited admin modules).
# The worker (apps/worker) reads SUPABASE_URL and SUPABASE_SECRET_KEY from its own
# environment; locally, take them from `supabase status -o env`. Optional: WORKER_ID,
# POLL_INTERVAL_MS (default 2000), STALE_AFTER_MS (default 300000).

# Spam protection for the support form: a random value of 32+ characters
# (e.g. `node -e "console.log(crypto.randomBytes(32).toString('base64url'))"`).
# Server only. Required for the Contact & Support form.
RATE_LIMIT_SECRET=replace-me-with-32-or-more-random-characters

# Support form email notifications through Resend. Optional: without them,
# requests are stored but no email is sent. SUPPORT_EMAIL_FROM must be an
# address on a domain verified in Resend, e.g. "Full Court <support@example.com>".
# RESEND_API_KEY=
# SUPPORT_EMAIL_FROM=

# Maintenance mode: "on" answers every page and API call with 503.
# MAINTENANCE_MODE=on
